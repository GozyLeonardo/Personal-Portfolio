# Optional — copy to .env.local and fill in
# RESEND_API_KEY=
# NEXT_PUBLIC_GA_ID=

# ── AI provider ──────────────────────────────────────────────
# Single key for all AI features: Signal Chat, First Line, Repurpose, and The Brief.
# DeepSeek — OpenAI-compatible, far cheaper than Anthropic.
DEEPSEEK_API_KEY=

# Gate for the AI tools. Keep "false" until credits + Turnstile are set,
# then flip to "true" in Vercel and redeploy to make First Line + Repurpose live.
NEXT_PUBLIC_TOOLS_AI_ENABLED=false

# Cloudflare Turnstile (human verification). Get free keys at
# dash.cloudflare.com → Turnstile. Local dev falls back to CF test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — global lifetime usage cap (800 AI calls). If unset,
# the lifetime cap is skipped (per-device cap + Turnstile still apply).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Airtable EMPIRE OS — lead capture from the upgrade nudge.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appB6wrdms88AoHK4
AIRTABLE_LEADS_TABLE=LEADS
